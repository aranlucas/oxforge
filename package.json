{
  "name": "@aranlucas/oxforge",
  "version": "0.3.0",
  "description": "Lucas's opinionated Oxlint and Oxfmt policy. Strict types, readable code, no slop.",
  "keywords": [
    "anti-slop",
    "oxfmt",
    "oxlint",
    "oxlint-config",
    "oxlint-plugin",
    "typescript"
  ],
  "homepage": "https://github.com/aranlucas/oxforge#readme",
  "bugs": "https://github.com/aranlucas/oxforge/issues",
  "license": "MIT",
  "author": "Lucas Arango",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aranlucas/oxforge.git"
  },
  "bin": {
    "oxforge": "./bin/oxforge.js"
  },
  "files": [
    "src/*.js",
    "src/*.d.ts",
    "dist",
    "rules",
    "bin",
    "CHANGELOG.md",
    "NOTICE.md",
    "configs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./format": {
      "types": "./src/format.d.ts",
      "default": "./src/format.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./rules/*": "./rules/*.json",
    "./package.json": "./package.json",
    "./configs/*": "./configs/*.json",
    "./format-config": {
      "types": "./src/format-config.d.ts",
      "default": "./src/format-config.js"
    },
    "./format-tailwind": {
      "types": "./src/format-tailwind.d.ts",
      "default": "./src/format-tailwind.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "build": "vp pack && node scripts/generate-configs.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "vp lint && vp lint --config configs/vitest.json . --deny-warnings",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "audit:projects": "node scripts/audit-projects.mjs",
    "test:watch": "vitest",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.1",
    "@oxlint/plugins": "1.89.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@shadcn/lint": "0.2.3",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tailwindcss": "1.16.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@shadcn/lint": "^0.2.1",
    "oxfmt": ">=0.73.0 <1.0.0",
    "oxlint": "^1.88.0",
    "oxlint-tailwindcss": "^1.16.0",
    "oxlint-tsgolint": "^7.0.2004"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    },
    "oxlint-tailwindcss": {
      "optional": true
    },
    "@shadcn/lint": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "vp lint --fix",
      "vp fmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "vp fmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.14.0"
}
